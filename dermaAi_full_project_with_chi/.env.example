# Set a unique secret before deploying anywhere beyond local evaluation.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret

# Optional; default local interface port is 8080.
DERMAAI_PORT=8080

# Hosted HAM10000 research model. Images are sent to this third-party API only after in-app consent.
DERMOSCOPY_MODEL_API_URL=https://javariarizwan-ham10000-api.hf.space